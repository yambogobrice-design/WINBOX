# Accélération de l'installation (npm).
# Le cache npm de cette machine fait ~9,7 Go : on le réutilise dès que possible
# au lieu de tout retélécharger.
prefer-offline=true

# Désactive l'audit et le financement (deux requêtes réseau supplémentaires
# qui peuvent ralentir ou suspendre l'installation).
audit=false
fund=false

# Délais réseau : moins de timeouts prématurés, tentatives limitées.
fetch-timeout=600000
fetch-retries=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# Journal plus lisible (les paquets s'affichent, pas le bavardage).
loglevel=warn
