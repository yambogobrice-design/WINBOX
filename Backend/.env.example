# ============================================
# Configuration du serveur
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# Base de données MySQL
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=votre_mot_de_passe
DB_NAME=winbox_db

# ============================================
# Authentification JWT
# ============================================
# Générer une clé : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=votre_secret_jwt_tres_securise_changez_moi
JWT_EXPIRE=7d

# Durée de validité d'un lien de réinitialisation de mot de passe (minutes)
RESET_TOKEN_EXPIRE_MINUTES=60

# En développement uniquement : renvoyer le jeton de réinitialisation dans la
# réponse HTTP (aucun transport email n'est configuré). Laisser « false » en production.
EXPOSE_RESET_TOKEN=true

# ============================================
# CORS / URLs
# ============================================
# Une ou plusieurs origines séparées par des virgules
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ============================================
# Uploads
# ============================================
# Taille maximale d'un fichier en octets (50 Mo)
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# ============================================
# Limitation de débit
# ============================================
RATE_LIMIT_MAX=500
RATE_LIMIT_AUTH_MAX=20

# ============================================
# Compte administrateur créé par « npm run seed »
# ============================================
ADMIN_EMAIL=admin@winbox.com
ADMIN_PASSWORD=Admin@123
ADMIN_NOM=WinBox
ADMIN_PRENOM=Admin

# ============================================
# API
# ============================================
API_PREFIX=/api/v1
